# Auto detect text files and perform LF normalization
* text=auto

# Explicitly ensure POSIX shell scripts always use LF line endings
gradlew text eol=lf
*.sh text eol=lf

# Windows batch files use CRLF
gradlew.bat text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.jar binary
*.apk binary
*.aab binary
*.png binary
*.jpg binary
*.webp binary
